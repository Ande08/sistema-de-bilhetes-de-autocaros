PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_bilhetes
DB_USER=root
DB_PASSWORD=
# Limites por processo para proteger o MySQL partilhado da VPS.
DB_MAX_PREPARED_STATEMENTS_PER_CONNECTION=250
DB_POOL_MAX=5
JWT_SECRET=alterar_esta_chave
JWT_EXPIRACAO=1d
ADMIN_NOME=Administrador
ADMIN_APELIDO=Sistema
ADMIN_TELEFONE=+258840000001
ADMIN_PASSWORD=alterar_palavra_passe
OTP_FORNECEDOR=SIMULADO
OTP_VALIDADE_MINUTOS=10
OTP_REENVIO_SEGUNDOS=60
OTP_EXIBIR_CODIGO=true
PAGAMENTO_SIMULADO_ATRASO_MS=1200
# Duração do bloqueio temporário durante a escolha e o pagamento (1 a 10 minutos).
RESERVA_ASSENTO_MINUTOS=3
WHATSAPP_INICIAR_AUTOMATICAMENTE=false
WHATSAPP_SESSION_PATH=.dados/whatsapp
WHATSAPP_MOSTRAR_QR_TERMINAL=false
WHATSAPP_NOME_DISPOSITIVO=Viagem Bus Avisos
WHATSAPP_MAX_RECONEXOES=10
WHATSAPP_LOG_LEVEL=silent
WHATSAPP_RETENCAO_DIAS=90
WHATSAPP_PM2_NOME=viagem-bus-whatsapp
# PM2_EXECUTAVEL=pm2.cmd
CRIAR_DADOS_DEMO=false
